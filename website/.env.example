# JB Decor public website — environment configuration
# All values are build-time (Vite inlines VITE_* at build). Never put secrets here.

# Backend API base (same-origin /api behind nginx in production)
VITE_API_URL=/api

# Company contact details (used across footer, contact page, WhatsApp button)
VITE_WHATSAPP_NUMBER=919000000000
VITE_CONTACT_PHONE=+91 90000 00000
VITE_CONTACT_EMAIL=hello@jbdecor.com
VITE_CONTACT_ADDRESS=JB Decor Studio, Bengaluru, India

# Where the CRM app is reachable. The staff "Sign in to the CRM" link points at VITE_CRM_URL + /login.
#   - Option A production (one host): /crm            -> link = /crm/login  (nginx serves the CRM there)
#   - Local dev with the CRM on :5173: http://localhost:5173  -> link = http://localhost:5173/login
#   - CRM on its own domain:           https://crm.jbdecor.com -> link = https://crm.jbdecor.com/login
VITE_CRM_URL=/crm
