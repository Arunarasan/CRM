# Caddy reverse proxy — automatic HTTPS (Let's Encrypt) in front of the `web` nginx container.
# Caddy terminates TLS on 443 (and redirects 80→443) and proxies to the internal `web` service.
#
# Requirements before this can issue a certificate:
#   1. jbdecorcdm.com (and www) DNS A records point at this VPS's public IP.
#   2. Ports 80 AND 443 are open to the internet on the VPS firewall.
# Let's Encrypt validates over HTTP-01 on port 80, so both must be reachable.

# Canonical host: redirect www → apex, then serve.
www.jbdecorcdm.com {
    redir https://jbdecorcdm.com{uri} permanent
}

jbdecorcdm.com {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), camera=(self), microphone=(self)"
        # Scripts only from this origin (both SPAs ship no inline scripts; JSON-LD blocks aren't executed,
        # face-api models are self-hosted), plus no plugins, no base-tag hijack, no framing by other sites.
        # "?" = default only: responses that set their own CSP (the sandbox on /uploads) keep it.
        ?Content-Security-Policy "script-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        -Server
    }
    reverse_proxy web:80
}
