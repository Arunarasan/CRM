<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for the Docker build on the VPS. Downloads come from Google's mirror of Maven
  Central instead of repo.maven.apache.org, which the VPS can't reliably reach (its route to
  Cloudflare-hosted sites is broken). Same artifacts, different host.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google mirror of Maven Central</name>
      <url>https://maven-central-asia.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
