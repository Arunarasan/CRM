

# Google review count sync (Workforce > Review Rewards). Leave empty to disable.
CRM_GOOGLE_PLACES_API_KEY=
CRM_GOOGLE_PLACES_PLACE_ID=

# --- Security (required) ---------------------------------------------------
# JWT signing key: openssl rand -base64 48   (never reuse an example value)
# JWT_SECRET=
# Encrypts Aadhaar/PAN/bank fields at rest: openssl rand -base64 32
# Keep a copy OUTSIDE the server — if it is lost those fields cannot be read again.
# PII_ENCRYPTION_KEY=

# --- Nightly encrypted off-site backup (optional; see docs/BACKUP_RESTORE.md) ---
# BACKUP_ENABLED=true
# BACKUP_ENCRYPTION_KEY=        # openssl rand -base64 32
# BACKUP_BUCKET=                # a PRIVATE bucket, not the public jbdecor one
# BACKUP_ENDPOINT=
# BACKUP_ACCESS_KEY=
# BACKUP_SECRET_KEY=
# PRIVATE_STORAGE_BUCKET=       # private bucket for sensitive uploads (empty = server volume)
