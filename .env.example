# =================================================================
# Arudra CRM - Production Environment Configuration Template
# Copy this file to .env and fill in your production values.
# NEVER commit the real .env file with secrets into version control!
# =================================================================

# -----------------------------------------------------------------
# 1. MySQL Database Configuration
# -----------------------------------------------------------------
MYSQL_DATABASE=arudra_crm
MYSQL_USER=crm_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# -----------------------------------------------------------------
# 2. Spring Boot Backend Configuration
# -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=https://crm.example.com,http://localhost:80,http://localhost

# -----------------------------------------------------------------
# 3. Cloudflare R2 Object Storage (File & Document Storage)
# -----------------------------------------------------------------
STORAGE_TYPE=s3
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=jbdecor
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Public URL for viewing images (e.g. https://pub-xxxxxx.r2.dev or https://media.example.com)
R2_PUBLIC_DOMAIN=

# -----------------------------------------------------------------
# 4. Frontend & Port Bindings
# -----------------------------------------------------------------
# Frontend API URL (default: /api for Nginx reverse proxy routing)
VITE_API_URL=/api

# Exposed host ports
FRONTEND_PORT=80
BACKEND_PORT=8080
