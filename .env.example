# =================================================================
# Arudra CRM - Production Environment Configuration Template
# Create /opt/crm/.env on your VPS using this template.
# NEVER commit the real .env file with secrets into version control!
# =================================================================

# -----------------------------------------------------------------
# 1. MySQL Database Configuration
# -----------------------------------------------------------------
MYSQL_DATABASE=arudra_crm
MYSQL_USER=crm_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# -----------------------------------------------------------------
# 2. Spring Boot Backend Configuration
# -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_SECRET_KEY
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://187.127.171.110,http://localhost:80,https://crm.example.com

# -----------------------------------------------------------------
# 3. Cloudflare R2 Object Storage (File & Media Storage)
# -----------------------------------------------------------------
STORAGE_TYPE=s3
R2_ACCOUNT_ID=6ded68d1395464810b575e43d47d5346
R2_BUCKET_NAME=jbdecor
R2_ENDPOINT=https://6ded68d1395464810b575e43d47d5346.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME_YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=CHANGE_ME_YOUR_R2_SECRET_ACCESS_KEY
# Public URL for viewing images (e.g. https://pub-xxxxxx.r2.dev or https://media.yourdomain.com)
R2_PUBLIC_DOMAIN=

# -----------------------------------------------------------------
# 4. Frontend & Host Port Bindings
# -----------------------------------------------------------------
# Frontend API URL (default: /api for Nginx reverse proxy routing)
VITE_API_URL=/api
VITE_API_BASE_URL=/api

# Exposed host ports on VPS
FRONTEND_PORT=80
BACKEND_PORT=8080
